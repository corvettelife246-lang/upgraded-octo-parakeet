# Copy this file to .env and fill in your values
# cp .env.example .env

# ══════════════════════════════════════════════════════════════════
# LLM BACKEND — choose one:
#   anthropic  → Anthropic Claude API (requires API key, internet)
#   foundry    → Microsoft Foundry Local (offline, local GPU)
# ══════════════════════════════════════════════════════════════════
LLM_BACKEND=foundry

# ── Microsoft Foundry Local (offline / local GPU) ─────────────────
# Install on Windows: winget install Microsoft.FoundryLocal
# Start service:      foundry model run phi-4-mini
# See guide:          setup/foundry_local.md
#
# Available models: phi-4-mini, phi-4, phi-3.5-mini,
#                   llama-3.2-3b, llama-3.1-8b, mistral-7b, qwen2.5-7b
FOUNDRY_LOCAL_MODEL=phi-4-mini
# URL auto-detected from WSL-2 nameserver. Override if needed:
# FOUNDRY_LOCAL_HOST=172.28.80.1
# FOUNDRY_LOCAL_URL=http://172.28.80.1:5273

# ── Anthropic Claude API (cloud — only needed if LLM_BACKEND=anthropic) ──
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
DEFAULT_MODEL=claude-opus-4-7
REASONING_MODEL=claude-opus-4-7
FAST_MODEL=claude-haiku-4-5-20251001

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=change-me-in-production

# ── Voice / STT ───────────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large
# Larger = more accurate but slower / more RAM
WHISPER_MODEL=base

# TTS engine: edge (neural, requires internet) | pyttsx3 (offline) | gtts
TTS_ENGINE=edge
TTS_VOICE=en-US-AriaNeural

# ── Vision / Camera ───────────────────────────────────────────────
# Camera device index (0 = first camera)
CAMERA_INDEX=0
VIDEO_FPS=30
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720

# ── Agents ────────────────────────────────────────────────────────
MAX_AGENTS=10
AGENT_TIMEOUT=120
MAX_REASONING_TOKENS=8000
