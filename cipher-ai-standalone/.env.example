# Copy this to .env and fill in your values
NODE_ENV=development
PORT=3001

# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret

# Admin password for generating/revoking licenses
ADMIN_PASSWORD=change-me

# Microsoft Foundry Local AI server
# On WSL2 with Windows 10, use the Windows host IP:
#   cat /etc/resolv.conf | grep nameserver
# On WSL2 with Windows 11 mirrored networking, localhost works.
FOUNDRY_HOST=localhost
FOUNDRY_PORT=5273

# Model ID to use from Foundry Local (run `foundry model list` to see available)
FOUNDRY_MODEL=phi-3.5-mini-instruct
